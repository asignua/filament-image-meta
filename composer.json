{
    "name": "asignua/filament-image-meta",
    "description": "Per-file alt text (per locale), a decorative flag, caption, title and focal point for Filament 5's own FileUpload and SpatieMediaLibraryFileUpload — one wrapper around the upload you already have, no media library to adopt. A missing alt is reported (form badge, optional validation, data attribute) and never replaced by the file name; an accessible Blade <img> component renders alt, caption and the focal point as object-position.",
    "keywords": ["filament", "filament-plugin", "laravel", "file-upload", "alt-text", "accessibility", "a11y", "seo", "focal-point", "media-library"],
    "homepage": "https://github.com/asignua/filament-image-meta",
    "support": {
        "issues": "https://github.com/asignua/filament-image-meta/issues",
        "source": "https://github.com/asignua/filament-image-meta"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "suggest": {
        "filament/spatie-laravel-media-library-plugin": "Store the details in the custom properties of each media item (SpatieMediaLibraryFileUpload).",
        "spatie/laravel-medialibrary": "Read the details back with ImageMeta::forMedia()."
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentImageMeta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentImageMeta\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentImageMeta\\ImageMetaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
